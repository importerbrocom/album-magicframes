# =============================================================================
# Magic Frames — backend .env for cPanel (album-magicframes.nokkoo.in)
# Copy to:  /home/uddjzwrz/laravel/album-magicframes/backend/.env   then fill the SECRETS.
# This file must NEVER be committed with real secrets in it.
# =============================================================================

APP_NAME="Magic Frames"
APP_ENV=production
APP_KEY=                                  # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://album-magicframes.nokkoo.in

# Single-origin deployment: the SPA and API share this domain.
ALBUM_PUBLIC_BASE_URL=https://album-magicframes.nokkoo.in
FRONTEND_URL=https://album-magicframes.nokkoo.in
SANCTUM_STATEFUL_DOMAINS=album-magicframes.nokkoo.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Database (cPanel MySQL/MariaDB) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uddjzwrz_albummagicframes
# In cPanel the DB user is usually the same as the DB name, but CONFIRM it under
# cPanel -> MySQL Databases -> "Current Users". Replace if different.
DB_USERNAME=uddjzwrz_albummagicframes
DB_PASSWORD=PUT_YOUR_DB_PASSWORD_HERE

# ---- Queue / cache / session ----
# "database" lets Drive syncs run in the background via a worker/cron. If your
# cPanel plan can't keep a worker running, set QUEUE_CONNECTION=sync to process
# syncs inline during the request (simpler, but album creation waits for sync).
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@magicframes.nokkoo.in"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Album access token (public viewers) ----
# Generate: php -r "echo bin2hex(random_bytes(32));"
ALBUM_TOKEN_SECRET=
ALBUM_TOKEN_TTL_HOURS=24

# ---- Google Drive ----
# Start in demo mode to verify the deployment end-to-end, then switch to real
# credentials and set DRIVE_DEMO_MODE=false.
GOOGLE_DRIVE_AUTH_MODE=api_key
GOOGLE_DRIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://album-magicframes.nokkoo.in/api/admin/google/callback
GOOGLE_REFRESH_TOKEN=
DRIVE_DEMO_MODE=true
