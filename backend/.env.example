APP_NAME="Magic Frames"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.yourdomain.com

# Public base URL of the React app, used to build shareable album links.
ALBUM_PUBLIC_BASE_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (MySQL / MariaDB in production) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magicframes
DB_USERNAME=magicframes
DB_PASSWORD=

# For local development you can instead use SQLite:
#   DB_CONNECTION=sqlite    (and `touch database/database.sqlite`)

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "database" and run `php artisan queue:work` so Drive syncs run in the
# background. Use "sync" to process jobs inline (simplest, no worker needed).
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Album access token (public viewers) ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
ALBUM_TOKEN_SECRET=
ALBUM_TOKEN_TTL_HOURS=24

# --- Sanctum (admin SPA) ---
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Google Drive integration ---
# AUTH MODE:
#   api_key -> read folders that are shared "anyone with the link can view"
#   oauth   -> read folders owned by / shared with a connected Google account
GOOGLE_DRIVE_AUTH_MODE=api_key

# API key mode:
GOOGLE_DRIVE_API_KEY=

# OAuth mode (connected account). Obtain a refresh token once via the OAuth
# consent flow with the drive.readonly scope, then store it here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/admin/google/callback
GOOGLE_REFRESH_TOKEN=

# Demo mode: when true AND no Drive credentials are set, album syncs use local
# fixture data (public placeholder images) so you can explore the full app
# without a Google account. Set to false in production.
DRIVE_DEMO_MODE=false

# --- Google review link (shown on the public album) ---
# Global default; each album can override it in the admin.
GOOGLE_REVIEW_URL=

# --- CRN (CRM) enquiry forwarding -> https://magicframes.nokkoo.in ---
# Enquiries are always stored locally AND POSTed to this endpoint. Leave the
# endpoint blank to only store them locally (viewable in the admin panel).
CRN_ENDPOINT=
CRN_METHOD=POST
# Set true to send application/x-www-form-urlencoded instead of JSON.
CRN_AS_FORM=false
CRN_SOURCE=web-album
# Optional auth for the CRN endpoint:
CRN_TOKEN=
CRN_TOKEN_HEADER=Authorization
CRN_TOKEN_PREFIX="Bearer "
# Field-name mapping (only set if the CRN expects different keys):
# CRN_FIELD_NAME=name
# CRN_FIELD_PHONE=phone
# CRN_FIELD_EMAIL=email
# CRN_FIELD_MESSAGE=message
# CRN_FIELD_SOURCE=source
# CRN_FIELD_ALBUM=album
