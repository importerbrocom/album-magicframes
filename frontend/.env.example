# Base URL of the Laravel API.
# In development, leave this unset and the Vite dev proxy forwards /api to the
# backend (see vite.config.js). In production, set it to your API origin:
VITE_API_URL=https://api.yourdomain.com/api

# Optional: override the dev proxy target (defaults to http://127.0.0.1:8000)
# VITE_API_PROXY=http://127.0.0.1:8000
